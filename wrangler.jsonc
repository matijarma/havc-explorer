{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "havc-explorer",
	"main": "worker/index.js",
	// Matches the date the live Worker already reports, so this file taking over
	// from the dashboard config changes no runtime behaviour.
	"compatibility_date": "2026-07-31",
	"compatibility_flags": ["nodejs_compat"],

	// Workers Builds applies THIS file on every push to master and replaces
	// dashboard-held settings. Every value below was read back off the live
	// Worker before this file existed — do not drop one assuming it is a default.
	"observability": { "enabled": true },

	"assets": {
		// The repo root. `.assetsignore` controls what is actually public.
		"directory": ".",
		"binding": "ASSETS"
		// No `run_worker_first`: assets are matched first and served free, and
		// non-asset paths fall through to the Worker on their own. Setting it to
		// true would bill every page load against the account-wide request budget.
	},

	// Usage-measurement store (see worker/schema.sql). D1 rather than Analytics
	// Engine so history is permanent without a cron: compaction runs on /stats
	// visits, and AE's 90-day retention would lose data between visits.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "havc-explorer-db",
			"database_id": "86eca9f4-0bfd-43dc-b15b-7c066a68f715"
		}
	],

	// Throttles the public /api/u beacon per client IP. The IP is only a
	// transient rate-limit key at the edge; it is never stored.
	"ratelimits": [
		{
			"name": "RL_HIT",
			"namespace_id": "2001",
			"simple": { "limit": 30, "period": 60 }
		}
	]
}
